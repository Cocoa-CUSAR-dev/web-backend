# Copy this file to `.env` at the project root (same folder as build.gradle.kts) and fill in
# real values. Never commit the real .env. Consumed by spring-dotenv at runtime AND by the
# jOOQ codegen in build.gradle.kts, so it must exist before `./gradlew generateJooq`.

SPRING_APPLICATION_NAME=web

# NeonDB
# Must include ?sslmode=require (Neon's endpoint expects TLS) -- the app
# itself does not enforce this, it just forwards whatever URL is set here
# straight to the JDBC driver.
SPRING_DATASOURCE_URL=                          # jdbc:postgresql://...?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=32
SPRING_DATASOURCE_HIKARI_MIN_IDLE=10
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000
# Both optional -- application.properties defaults to 240000/120000 if unset.
# Keeps pooled connections from going stale against Neon's pooler endpoint,
# which closes idle server-side connections well before Hikari's own default
# (30 min) would otherwise recycle them.
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=240000
SPRING_DATASOURCE_HIKARI_KEEPALIVE_TIME=120000

CORS_ORIGIN=                                     # allowed web origin, e.g. http://localhost:3000

SERVER_CONTEXT_PATH=/api/v1
SERVER_PORT=3001

JWT_KEY=                                         # secret signing key — generate a strong random value
JWT_NAME=                                        # cookie name for the JWT
JWT_ACCESS_TOKEN_EXPIRATION=36000000             # milliseconds
JWT_REFRESH_TOKEN_EXPIRATION=86400000            # milliseconds

# Marks the JWT cookie Secure (HTTPS-only). Leave true everywhere except local
# dev over plain http://localhost, where a Secure cookie would never be sent
# back by the browser and login would silently appear broken.
COOKIE_SECURE=true

# Chatbot service auth — GET /service/forms/{formId}, gated by ServiceKeyFilter
# (separate trust model from farmer/researcher JWTs, see that filter's own
# comment). Generate a strong random value; the chatbot's own .env needs the
# SAME value, sent as the X-Service-Key header. Distinct secret from
# mobile-backend's CHATBOT_SERVICE_KEY — rotating one independently of the
# other shouldn't require touching both.
CHATBOT_SERVICE_KEY=

# Outbound direction (new): this service calling INTO the chatbot service's
# POST /service/reminders (FormService.createForm, via ChatbotClient), the
# reverse of CHATBOT_SERVICE_KEY above. Two DIFFERENT env vars on purpose --
# they're two unrelated secrets even though both involve "this service and
# chatbot": CHATBOT_SERVICE_KEY is a secret chatbot owns and this service
# only checks; the two below are secrets chatbot owns and this service must
# present. CHATBOT_SERVICE_URL is the chatbot deployment's base URL (e.g.
# https://<project>.vercel.app, no trailing slash). CHATBOT_REMINDER_SERVICE_KEY
# must match the CHATBOT_SERVICE_KEY value set on the chatbot service itself
# (its own .env.sample, src/notifications/config.py) -- confusingly similar
# name, deliberately a separate value.
CHATBOT_SERVICE_URL=
CHATBOT_REMINDER_SERVICE_KEY=

# US2-6: Gemini via Google AI Studio, used to polish the daily diary
# template's wording. Leaving this blank is safe -- diary generation
# falls back to the plain template text instead of failing.
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=

SWAGGER_UI_PATH=/swagger-ui.html
API_DOCS_PATH=/api-docs

# Error tracking (X-2d). Leave blank to disable the SDK entirely (safe for
# local dev/CI) -- get the real DSN from the team's Sentry project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
